{
  "info": {
    "name": "Test Steps",
    "description": "Test step management endpoints with comprehensive tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "testCaseId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "testStepId",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Login - Setup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"demo123\",\n  \"username_or_email\": \"demo@testmona.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "token"
          ]
        },
        "description": "Login to get access token for subsequent requests"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains access_token\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('access_token');",
              "    pm.environment.set(\"accessToken\", jsonData.access_token);",
              "    if (jsonData.refresh_token) {",
              "        pm.environment.set(\"refreshToken\", jsonData.refresh_token);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Create Test Step",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"test_case_id\": {{testCaseId}},\n  \"step_number\": 1,\n  \"action\": \"Navigate to login page\",\n  \"expected_result\": \"Login page is displayed with username and password fields\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/test-steps",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "test-steps"
          ]
        },
        "description": "Create a new test step"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200, 201, or 404 (test case not found)\", function () {",
              "    pm.expect([200, 201, 404]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "    pm.test(\"Response contains test step data\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData).to.have.property('id');",
              "        pm.expect(jsonData).to.have.property('test_case_id');",
              "        pm.expect(jsonData).to.have.property('step_number');",
              "        pm.expect(jsonData).to.have.property('action');",
              "        pm.expect(jsonData).to.have.property('expected_result');",
              "    });",
              "    ",
              "    pm.test(\"Step number matches request\", function () {",
              "        var jsonData = pm.response.json();",
              "        var requestBody = JSON.parse(pm.request.body.raw);",
              "        pm.expect(jsonData.step_number).to.eql(requestBody.step_number);",
              "    });",
              "    ",
              "    pm.test(\"Action is not empty\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData.action).to.not.be.empty;",
              "    });",
              "    ",
              "    // Store test step ID for subsequent tests",
              "    pm.environment.set(\"testStepId\", pm.response.json().id);",
              "} else {",
              "    pm.test(\"Test case not found - creation skipped\", function () {",
              "        console.log(\"Test case ID not set or not found\");",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Test Steps",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/test-steps?test_case_id={{testCaseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "test-steps"
          ],
          "query": [
            {
              "key": "test_case_id",
              "value": "{{testCaseId}}"
            }
          ]
        },
        "description": "Retrieve test steps for a test case"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 or 404\", function () {",
              "    pm.expect([200, 404]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    pm.test(\"Response is an array\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData).to.be.an('array');",
              "    });",
              "    ",
              "    pm.test(\"Steps are ordered by step_number\", function () {",
              "        var jsonData = pm.response.json();",
              "        if (jsonData.length > 1) {",
              "            for (var i = 0; i < jsonData.length - 1; i++) {",
              "                pm.expect(jsonData[i].step_number).to.be.at.most(jsonData[i + 1].step_number);",
              "            }",
              "        }",
              "    });",
              "} else {",
              "    pm.test(\"Test case not found - get test steps skipped\", function () {",
              "        console.log(\"Test case ID not set or not found\");",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Update Test Step",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"Updated action: Navigate to login page\",\n  \"expected_result\": \"Updated expected result\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/test-steps/{{testStepId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "test-steps",
            "{{testStepId}}"
          ]
        },
        "description": "Update test step details"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 or 404\", function () {",
              "    pm.expect([200, 404]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    pm.test(\"Test step updated successfully\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData).to.have.property('action');",
              "        pm.expect(jsonData).to.have.property('expected_result');",
              "    });",
              "    ",
              "    pm.test(\"Updated values match request\", function () {",
              "        var jsonData = pm.response.json();",
              "        var requestBody = JSON.parse(pm.request.body.raw);",
              "        pm.expect(jsonData.action).to.eql(requestBody.action);",
              "    });",
              "} else {",
              "    pm.test(\"Test step not found - update skipped\", function () {",
              "        console.log(\"Test step ID not set or not found\");",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Delete Test Step",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/test-steps/{{testStepId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "test-steps",
            "{{testStepId}}"
          ]
        },
        "description": "Delete a test step"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200, 204, or 404\", function () {",
              "    pm.expect([200, 204, 404]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200 || pm.response.code === 204) {",
              "    pm.test(\"Test step deleted successfully\", function () {",
              "        var jsonData = pm.response.json();",
              "        if (jsonData) {",
              "            pm.expect(jsonData).to.have.property('message');",
              "        }",
              "    });",
              "} else {",
              "    pm.test(\"Test step not found - delete skipped\", function () {",
              "        console.log(\"Test step ID not set or not found\");",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
