{
  "info": {
    "name": "Test Cases",
    "description": "Test case management endpoints with comprehensive tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "testSuiteId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "testCaseId",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Login - Setup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"demo123\",\n  \"username_or_email\": \"demo@testmona.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "token"
          ]
        },
        "description": "Login to get access token for subsequent requests"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains access_token\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('access_token');",
              "    pm.environment.set(\"accessToken\", jsonData.access_token);",
              "    if (jsonData.refresh_token) {",
              "        pm.environment.set(\"refreshToken\", jsonData.refresh_token);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Create Test Case",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Test User Login Functionality\",\n  \"description\": \"Verify that users can successfully login with valid credentials\",\n  \"test_suite_id\": {{testSuiteId}},\n  \"priority\": \"high\",\n  \"status\": \"active\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/test-cases",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "test-cases"
          ]
        },
        "description": "Create a new test case"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200, 201, or 404 (test suite not found)\", function () {",
              "    pm.expect([200, 201, 404]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "    pm.test(\"Response contains test case data\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData).to.have.property('id');",
              "        pm.expect(jsonData).to.have.property('title');",
              "        pm.expect(jsonData).to.have.property('description');",
              "        pm.expect(jsonData).to.have.property('test_suite_id');",
              "        pm.expect(jsonData).to.have.property('priority');",
              "        pm.expect(jsonData).to.have.property('status');",
              "    });",
              "    ",
              "    pm.test(\"Title matches request\", function () {",
              "        var jsonData = pm.response.json();",
              "        var requestBody = JSON.parse(pm.request.body.raw);",
              "        pm.expect(jsonData.title).to.eql(requestBody.title);",
              "    });",
              "    ",
              "    pm.test(\"Priority is valid\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(['low', 'medium', 'high', 'critical']).to.include(jsonData.priority);",
              "    });",
              "    ",
              "    pm.test(\"Status is valid\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(['active', 'archived', 'draft']).to.include(jsonData.status);",
              "    });",
              "    ",
              "    // Store test case ID for subsequent tests",
              "    pm.environment.set(\"testCaseId\", pm.response.json().id);",
              "} else {",
              "    pm.test(\"Test suite not found - creation skipped\", function () {",
              "        console.log(\"Test suite ID not set or not found\");",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Test Cases",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/test-cases?test_suite_id={{testSuiteId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "test-cases"
          ],
          "query": [
            {
              "key": "test_suite_id",
              "value": "{{testSuiteId}}"
            }
          ]
        },
        "description": "Retrieve test cases for a test suite"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 or 404\", function () {",
              "    pm.expect([200, 404]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    pm.test(\"Response is an array\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData).to.be.an('array');",
              "    });",
              "    ",
              "    pm.test(\"Each test case has required fields\", function () {",
              "        var jsonData = pm.response.json();",
              "        if (jsonData.length > 0) {",
              "            pm.expect(jsonData[0]).to.have.property('id');",
              "            pm.expect(jsonData[0]).to.have.property('title');",
              "            pm.expect(jsonData[0]).to.have.property('test_suite_id');",
              "        }",
              "    });",
              "} else {",
              "    pm.test(\"Test suite not found - get test cases skipped\", function () {",
              "        console.log(\"Test suite ID not set or not found\");",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Test Case by ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/test-cases/{{testCaseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "test-cases",
            "{{testCaseId}}"
          ]
        },
        "description": "Retrieve specific test case by ID"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 or 404\", function () {",
              "    pm.expect([200, 404]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    pm.test(\"Response contains test case data\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData).to.have.property('id');",
              "        pm.expect(jsonData).to.have.property('title');",
              "        pm.expect(jsonData).to.have.property('description');",
              "        pm.expect(jsonData).to.have.property('priority');",
              "        pm.expect(jsonData).to.have.property('status');",
              "    });",
              "    ",
              "    pm.test(\"Test case ID matches request\", function () {",
              "        var jsonData = pm.response.json();",
              "        var testCaseId = pm.environment.get(\"testCaseId\");",
              "        if (testCaseId) {",
              "            pm.expect(jsonData.id.toString()).to.eql(testCaseId.toString());",
              "        }",
              "    });",
              "} else {",
              "    pm.test(\"Test case not found - test skipped\", function () {",
              "        console.log(\"Test case ID not set or not found\");",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Update Test Case",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated Test Case Title {{$timestamp}}\",\n  \"priority\": \"critical\",\n  \"status\": \"active\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/test-cases/{{testCaseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "test-cases",
            "{{testCaseId}}"
          ]
        },
        "description": "Update test case details"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 or 404\", function () {",
              "    pm.expect([200, 404]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    pm.test(\"Test case updated successfully\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData).to.have.property('title');",
              "        pm.expect(jsonData).to.have.property('priority');",
              "    });",
              "    ",
              "    pm.test(\"Updated values match request\", function () {",
              "        var jsonData = pm.response.json();",
              "        var requestBody = JSON.parse(pm.request.body.raw);",
              "        pm.expect(jsonData.title).to.eql(requestBody.title);",
              "        pm.expect(jsonData.priority).to.eql(requestBody.priority);",
              "    });",
              "} else {",
              "    pm.test(\"Test case not found - update skipped\", function () {",
              "        console.log(\"Test case ID not set or not found\");",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Delete Test Case",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/test-cases/{{testCaseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "test-cases",
            "{{testCaseId}}"
          ]
        },
        "description": "Delete a test case"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200, 204, or 404\", function () {",
              "    pm.expect([200, 204, 404]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200 || pm.response.code === 204) {",
              "    pm.test(\"Test case deleted successfully\", function () {",
              "        var jsonData = pm.response.json();",
              "        if (jsonData) {",
              "            pm.expect(jsonData).to.have.property('message');",
              "        }",
              "    });",
              "} else {",
              "    pm.test(\"Test case not found - delete skipped\", function () {",
              "        console.log(\"Test case ID not set or not found\");",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
