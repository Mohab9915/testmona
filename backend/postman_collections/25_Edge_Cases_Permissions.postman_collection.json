{
  "info": {
    "name": "Edge Cases - Permissions",
    "description": "Permission and authorization edge case tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Login - Setup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"demo123\",\n  \"username_or_email\": \"demo@testmona.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "token"
          ]
        },
        "description": "Login to get access token for subsequent requests"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains access_token\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('access_token');",
              "    pm.environment.set(\"accessToken\", jsonData.access_token);",
              "    if (jsonData.refresh_token) {",
              "        pm.environment.set(\"refreshToken\", jsonData.refresh_token);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Access Project Without Read Permission",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/projects/2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "projects",
            "2"
          ]
        },
        "description": "Expected: 403 Forbidden - Insufficient permissions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 403 or 404\", function () {",
              "    pm.expect([403, 404]).to.include(pm.response.code);",
              "});",
              "",
              "pm.test(\"Access denied\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('detail');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Update Project Without Write Permission",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Unauthorized Update\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/projects/2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "projects",
            "2"
          ]
        },
        "description": "Expected: 403 Forbidden - Insufficient permissions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 403 or 404\", function () {",
              "    pm.expect([403, 404]).to.include(pm.response.code);",
              "});",
              "",
              "pm.test(\"Access denied\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('detail');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Delete Project Without Delete Permission",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/projects/2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "projects",
            "2"
          ]
        },
        "description": "Expected: 403 Forbidden - Insufficient permissions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 403 or 404\", function () {",
              "    pm.expect([403, 404]).to.include(pm.response.code);",
              "});",
              "",
              "pm.test(\"Access denied\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('detail');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "View Another User Without Admin",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/users/2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "2"
          ]
        },
        "description": "Expected: 403 Forbidden - Not authorized to view this user"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 403 or 404\", function () {",
              "    pm.expect([403, 404]).to.include(pm.response.code);",
              "});",
              "",
              "pm.test(\"Access denied\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('detail');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Delete User Without Admin",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/users/2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "2"
          ]
        },
        "description": "Expected: 403 Forbidden - Only admins can delete users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 403 or 404\", function () {",
              "    pm.expect([403, 404]).to.include(pm.response.code);",
              "});",
              "",
              "pm.test(\"Access denied\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('detail');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Invitations Without Admin",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/invitations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "invitations"
          ]
        },
        "description": "Expected: 403 Forbidden - Only admins can view invitations"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
            "pm.test(\"Status code is 403 or 404\", function () {",
            "    pm.expect([403, 404]).to.include(pm.response.code);",
              "});",
              "",
            "pm.test(\"Access denied\", function () {",
            "    var jsonData = pm.response.json();",
            "    pm.expect(jsonData).to.have.property('detail');",
            "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
