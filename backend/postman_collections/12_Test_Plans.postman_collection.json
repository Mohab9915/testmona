{
  "info": {
    "name": "Test Plans",
    "description": "Test plan management endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "testProjectId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "testPlanId",
      "value": "1",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Login - Setup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"demo123\",\n  \"username_or_email\": \"demo@testmona.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "token"
          ]
        },
        "description": "Login to get access token for subsequent requests"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains access_token\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('access_token');",
              "    pm.environment.set(\"accessToken\", jsonData.access_token);",
              "    if (jsonData.refresh_token) {",
              "        pm.environment.set(\"refreshToken\", jsonData.refresh_token);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Create Test Plan",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Q1 Plan\",\n  \"description\": \"Q1 test plan\",\n  \"project_id\": {{testProjectId}},\n  \"created_by\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/test-plans",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "test-plans"
          ]
        },
        "description": "Create a new test plan"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200, 201, or 422\", function () {",
              "    pm.expect([200, 201, 422]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "    pm.test(\"Response has id\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData).to.have.property('id');",
              "        pm.environment.set(\"testPlanId\", jsonData.id);",
              "    });",
              "    ",
              "    pm.test(\"Response has required fields\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData).to.have.property('name');",
              "        pm.expect(jsonData).to.have.property('project_id');",
              "    });",
              "} else {",
              "    pm.test(\"Validation error - creation skipped\", function () {",
              "        console.log(\"Validation error creating test plan\");",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Test Plans",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/test-plans?project_id={{testProjectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "test-plans"
          ],
          "query": [
            {
              "key": "project_id",
              "value": "{{testProjectId}}"
            }
          ]
        },
        "description": "Get all test plans for a project"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Update Test Plan",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Plan\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/test-plans/{{testPlanId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "test-plans",
            "{{testPlanId}}"
          ]
        },
        "description": "Update a test plan"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 or 404\", function () {",
              "    pm.expect([200, 404]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    pm.test(\"Name updated\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData.name).to.eql('Updated Plan');",
              "    });",
              "} else {",
              "    pm.test(\"Test plan not found - update skipped\", function () {",
              "        console.log(\"Test plan ID not set or not found\");",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Delete Test Plan",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/test-plans/{{testPlanId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "test-plans",
            "{{testPlanId}}"
          ]
        },
        "description": "Delete a test plan"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200, 204, or 404\", function () {",
              "    pm.expect([200, 204, 404]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 404) {",
              "    pm.test(\"Test plan not found - delete skipped\", function () {",
              "        console.log(\"Test plan ID not set or not found\");",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
