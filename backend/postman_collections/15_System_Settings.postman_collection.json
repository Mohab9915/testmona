{
  "info": {
    "name": "System Settings",
    "description": "System settings management endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Login - Setup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"demo123\",\n  \"username_or_email\": \"demo@testmona.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "token"
          ]
        },
        "description": "Login to get access token for subsequent requests"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains access_token\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('access_token');",
              "    pm.environment.set(\"accessToken\", jsonData.access_token);",
              "    if (jsonData.refresh_token) {",
              "        pm.environment.set(\"refreshToken\", jsonData.refresh_token);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get System Settings",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/system-settings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "system-settings"
          ]
        },
        "description": "Get all system settings"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 or 404\", function () {",
              "    pm.expect([200, 404]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    pm.test(\"Response is object or array\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData).to.satisfy(function(value) {",
              "            return typeof value === 'object' && (Array.isArray(value) || !Array.isArray(value));",
              "        });",
              "    });",
              "} else {",
              "    pm.test(\"System settings endpoint not found - test skipped\", function () {",
              "        console.log(\"System settings endpoint not implemented\");",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Update Setting",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"key\": \"signup_enabled\",\n  \"value\": \"true\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/system-settings/signup_enabled",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "system-settings",
            "signup_enabled"
          ]
        },
        "description": "Update a system setting"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 or 404\", function () {",
              "    pm.expect([200, 404]).to.include(pm.response.code);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    pm.test(\"Setting updated\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData).to.have.property('key');",
              "        pm.expect(jsonData.value).to.eql('false');",
              "    });",
              "} else {",
              "    pm.test(\"System settings endpoint not found - test skipped\", function () {",
              "        console.log(\"System settings endpoint not implemented\");",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
