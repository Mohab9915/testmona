{
  "info": {
    "name": "System Settings",
    "description": "System settings management endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Login - Setup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"demo123\",\n  \"username_or_email\": \"demo@testmona.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "token"
          ]
        },
        "description": "Login to get access token for subsequent requests"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains access_token\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('access_token');",
              "    pm.environment.set(\"accessToken\", jsonData.access_token);",
              "    if (jsonData.refresh_token) {",
              "        pm.environment.set(\"refreshToken\", jsonData.refresh_token);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Public App Name",
      "auth": {
        "type": "noauth"
      },
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/system/settings/public/app_name",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "system",
            "settings",
            "public",
            "app_name"
          ]
        },
        "description": "Get the public application display name without authentication"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains app_name\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.key).to.eql('app_name');",
              "    pm.expect(jsonData.value).to.be.a('string').and.not.empty;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Public Signup Setting",
      "auth": {
        "type": "noauth"
      },
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/system/settings/public/signup_enabled",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "system",
            "settings",
            "public",
            "signup_enabled"
          ]
        },
        "description": "Get the public signup setting without authentication"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains signup_enabled\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.key).to.eql('signup_enabled');",
              "    pm.expect(['true', 'false']).to.include(jsonData.value);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get System Settings",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/system/settings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "system",
            "settings"
          ]
        },
        "description": "Get all system settings"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is an array\", function () {",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Create App Name Setting",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"key\": \"app_name\",\n  \"value\": \"TestMona\",\n  \"description\": \"Application display name\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/system/settings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "system",
            "settings"
          ]
        },
        "description": "Create the application display name setting if it does not already exist"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 or already exists\", function () {",
              "    pm.expect([200, 409]).to.include(pm.response.code);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Update App Name Setting",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"value\": \"TestMona\",\n  \"description\": \"Application display name\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/system/settings/app_name",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "system",
            "settings",
            "app_name"
          ]
        },
        "description": "Update the application display name"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Setting updated\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.key).to.eql('app_name');",
              "    pm.expect(jsonData.value).to.eql('TestMona');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
